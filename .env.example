# Copy to api/.env and fill in. Never commit the real keys.
GEMINI_API_KEY=
# Check AI Studio for the current model ID and pin it (avoid "-latest" aliases on demo day)
GEMINI_MODEL=gemini-3-flash-preview

# Optional: ElevenLabs voice. Without these, the app uses the browser's built-in voice.
ELEVENLABS_API_KEY=
# Pick a voice in the ElevenLabs Voice Library and paste its ID
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional: free openFDA key for higher rate limits (https://open.fda.gov/apis/authentication
OPENFDA_API_KEY=